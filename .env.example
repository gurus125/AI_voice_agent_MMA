# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# Gemini API key (server-side only; used from Milestone 3 onward)
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase (used from Milestone 6 onward)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional: override the Gemini Live model (default: gemini-3.8-live)
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: cap on voice sessions one user can start per hour (default 30)
# MAX_SESSIONS_PER_HOUR=30

# Optional: origins allowed to embed /embed in an <iframe> (space-separated). Default: same origin only.
# EMBED_ALLOWED_ORIGINS=https://example.com
